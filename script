local function createActionBtn(parent, text, yPos, callback)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, -30, 0, 35)
    frame.Position = UDim2.new(0, 15, 0, yPos)
    frame.BackgroundColor3 = White
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local grad = Instance.new("UIGradient", frame)
    grad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, PurpleMain), ColorSequenceKeypoint.new(1, PurpleDark)}
    grad.Rotation = 45
    
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = text
    btn.TextColor3 = White
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.AutoButtonColor = false
    
    btn.MouseButton1Click:Connect(function()
        playSound(SND_CLICK)
        local orig = frame.Size
        local tween = TweenService:Create(frame, TweenInfo.new(0.1), {Size = UDim2.new(orig.X.Scale, orig.X.Offset - 4, orig.Y.Scale, orig.Y.Offset - 4)})
        local tween2 = TweenService:Create(frame, TweenInfo.new(0.1), {Size = orig})
        tween:Play()
        tween.Completed:Connect(function() tween2:Play() end)
        callback(btn, grad)
    end)
    return btn
end

