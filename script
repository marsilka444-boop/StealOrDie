local function updateLootESP()
    espLootList = clearList(espLootList)
    if not isLootEspEnabled and not targetLootItem then return end
    
    local folder = Workspace:FindFirstChild(LOOT_FOLDER_NAME) or Workspace:FindFirstChild(LOOT_FOLDER_NAME, true)
    if not folder then return end

    for _, item in ipairs(folder:GetChildren()) do
        if isLootEspEnabled or item == targetLootItem then
            local isTarget = (targetLootItem == item)
            local hl = Instance.new("Highlight", item)
            
            if isTarget then
                hl.FillColor = Color3.fromRGB(255, 105, 180)
            else
                hl.FillColor = Color3.fromRGB(255, 215, 0)
            end
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            table.insert(espLootList, hl)

            local price = getNumericPrice(item)
            if price > 0 then
                local part = item:IsA("Model") and item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                if part then
                    local bb = Instance.new("BillboardGui", part)
                    bb.Size = UDim2.fromOffset(100, 30)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.AlwaysOnTop = true

                    local txt = Instance.new("TextLabel", bb)
                    txt.Size = UDim2.fromScale(1, 1)
                    txt.BackgroundTransparency = 1
                    txt.Text = "$" .. price
                    txt.Font = Enum.Font.GothamBlack
                    txt.TextSize = 16
                    txt.TextColor3 = getPriceColor(price)
                    txt.TextStrokeTransparency = 0
                    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

                    table.insert(espLootList, bb)
