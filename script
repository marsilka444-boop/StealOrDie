local function getChar()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return char, hrp, hum end
    end
    return nil
end

local function getObjPos(obj)
    if obj:IsA("Model") then 
        return obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position
    else 
        return obj.Position 
    end
end

local function unstuckCharacter()
    local char, hrp, hum = getChar()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
end

local function isExitDoor(obj)
    if not obj:IsA("Model") and not obj:IsA("BasePart") then return false end
    if obj.Name ~= "Door" and not CollectionService:HasTag(obj, "Door") then return false end
    return obj:FindFirstChild("ExitPoint", true) ~= nil
end

local function getItemPrice(item)
    local price = "?"
    local success, val = pcall(function() 
        return item:GetAttribute("Price") or item:GetAttribute("Value") or item:GetAttribute("Worth") 
    end)
    if success and val then price = tostring(val) end
    for _, child in pairs(item:GetChildren()) do
        if child.Name == "Price" or child.Name == "Value" or child.Name == "Cost" then
            price = tostring(child.Value)
            break
        end
    end
    return price
end

local function getNumericPrice(item)
    local priceStr = getItemPrice(item)
    local num = tonumber(string.match(priceStr, "%d+%.?%d*"))
    return num or 0
end

local function getPriceColor(price)
    local alpha = math.clamp(price / 2000, 0, 1) 
    return Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(255, 255, 0), alpha)
end

local function toggleInstantPrompt(state)
    isInstantPromptEnabled = state
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            if not obj:GetAttribute("OrigHold") then
                obj:SetAttribute("OrigHold", obj.HoldDuration)
            end
            obj.HoldDuration = isInstantPromptEnabled and 0 or obj:GetAttribute("OrigHold")
        end
    end
end

Workspace.DescendantAdded:Connect(function(desc)
    if desc:IsA("ProximityPrompt") and isInstantPromptEnabled then
        if not desc:GetAttribute("OrigHold") then
            desc:SetAttribute("OrigHold", desc.HoldDuration)
        end
        desc.HoldDuration = 0
    end
end)

local function createViewport(parent, item)
    local vp = Instance.new("ViewportFrame", parent)
    vp.Size = UDim2.new(0, 45, 1, -6)
    vp.Position = UDim2.new(0, 3, 0, 3)
    vp.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    vp.BackgroundTransparency = 0.2
    vp.Ambient = Color3.fromRGB(150, 150, 150)
    Instance.new("UICorner", vp).CornerRadius = UDim.new(0, 6)
    
    local clone = item:Clone()
    for _, desc in pairs(clone:GetDescendants()) do
        if desc:IsA("Script") or desc:IsA("ProximityPrompt") or desc:IsA("ClickDetector") or desc:IsA("Highlight") then
            desc:Destroy()
        end
    end
    local model = clone
    if not clone:IsA("Model") then
        model = Instance.new("Model")
        clone.Parent = model
        model.PrimaryPart = clone
    end
    model.Parent = vp
    local cam = Instance.new("Camera", vp)
    vp.CurrentCamera = cam
    
    local cframe, size = model:GetBoundingBox()
    local dist = size.Magnitude * 0.55 
    local rotatedCFrame = cframe * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(20), 0, 0)
    
    cam.CFrame = CFrame.new(rotatedCFrame.Position + Vector3.new(dist, dist, dist), cframe.Position)
end

local function clearList(list)
    for _, v in pairs(list) do if v then v:Destroy() end end
    return {}
end

local function updatePlayerESP()
    espPlayersList = clearList(espPlayersList)
    if not isPlayerEspEnabled then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p:GetAttribute("IsEntity") ~= true and p.Character:GetAttribute("IsEntity") ~= true then
                local hl = Instance.new("Highlight", p.Character)
                hl.FillColor = Color3.fromRGB(0, 255, 255)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                table.insert(espPlayersList, hl)
