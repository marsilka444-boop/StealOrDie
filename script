    local minDist = math.huge
    local char, hrp = getChar()
    if not hrp then return end
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Closet" and (obj:IsA("BasePart") or obj:IsA("Model")) then
            local pos = getObjPos(obj)
            local dist = (pos - hrp.Position).Magnitude
            if dist < minDist then
                minDist = dist
                closestCloset = obj
            end
        end
    end
    
    if closestCloset then
        spamInteract(closestCloset, statusLbl, "Hiding")
        btn.Text = "HIDING!"
        task.wait(1)
        btn.Text = "HIDE IN CLOSET"
    else
        playSound(SND_ERROR)
        btn.Text = "NO CLOSETS FOUND!"
        task.wait(1.5)
        btn.Text = "HIDE IN CLOSET"
    end
end)

