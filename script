function updateLootList()
    for _, child in pairs(listFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    
    local folder = Workspace:FindFirstChild(LOOT_FOLDER_NAME) or Workspace:FindFirstChild(LOOT_FOLDER_NAME, true)
    if not folder then
        statusLbl.Text = "Status: No Loot Found (Lobby?)"
        return
    end
    
    cachedLootItems = {}
    for _, item in ipairs(folder:GetChildren()) do
        table.insert(cachedLootItems, item)
    end
    
    if currentSortMode == "asc" then
        table.sort(cachedLootItems, function(a, b) return getNumericPrice(a) < getNumericPrice(b) end)
    elseif currentSortMode == "desc" then
        table.sort(cachedLootItems, function(a, b) return getNumericPrice(a) > getNumericPrice(b) end)
    end
    
    for _, item in ipairs(cachedLootItems) do
        local card = Instance.new("Frame", listFrame)
        card.Size = UDim2.new(1, -5, 0, 50)
        card.BackgroundColor3 = DarkGrey
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)
        
        createViewport(card, item)
        
        local nameLbl = Instance.new("TextLabel", card)
        nameLbl.Size = UDim2.new(1, -100, 0, 25)
        nameLbl.Position = UDim2.new(0, 55, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = item.Name
        nameLbl.TextColor3 = White
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 13
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local priceStr = getItemPrice(item)
        local priceLbl = Instance.new("TextLabel", card)
        priceLbl.Size = UDim2.new(1, -100, 0, 20)
        priceLbl.Position = UDim2.new(0, 55, 0, 25)
        priceLbl.BackgroundTransparency = 1
        priceLbl.Text = "Price: $" .. priceStr
        priceLbl.TextColor3 = Color3.fromRGB(50, 255, 50)
        priceLbl.Font = Enum.Font.GothamMedium
        priceLbl.TextSize = 12
        priceLbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local getBtn = Instance.new("TextButton", card)
        getBtn.Size = UDim2.new(0, 70, 0, 30)
        getBtn.Position = UDim2.new(1, -75, 0.5, -15)
        getBtn.BackgroundColor3 = Green
        getBtn.Text = "GET"
        getBtn.TextColor3 = White
        getBtn.Font = Enum.Font.GothamBold
        getBtn.TextSize = 12
        getBtn.AutoButtonColor = false
        Instance.new("UICorner", getBtn).CornerRadius = UDim.new(0, 6)
        
        getBtn.MouseButton1Click:Connect(function()
            playSound(SND_CLICK)
            targetLootItem = item 
            updateLootESP()
            spamInteract(item, statusLbl, "Looting " .. item.Name)
        end)
    end
    
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #cachedLootItems * 55)
    statusLbl.Text = "Status: Found " .. #cachedLootItems .. " items"
end

local function togglePanel()
    playSound(SND_CLICK)
    if not main.Visible then
        main.Visible = true
        main.Size = UDim2.fromOffset(0, 0)
        main.Position = UDim2.new(0.5, 0, 0.5, 0)
        TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(320, 400), Position = UDim2.new(0.5, -160, 0.5, -200)}):Play()
    else
        local tween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0,0), Position = UDim2.new(0.5, 0, 0.5, 0)})
        tween:Play()
        tween.Completed:Connect(function() main.Visible = false end)
    end
end

local function setTab(activeTab, activeContent)
    for _, tab in pairs({btnMainTab, btnVisualsTab, btnLootTab}) do
        if tab == activeTab then
            TweenService:Create(tab, TweenInfo.new(0.2), {BackgroundColor3 = PurpleMain, TextColor3 = White}):Play()
        else
            TweenService:Create(tab, TweenInfo.new(0.2), {BackgroundColor3 = DarkGrey, TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
        end
    end

    for _, content in pairs({contentMain, contentVisuals, contentLoot}) do
        if content == activeContent then
            content.Visible = true
            content.Position = UDim2.new(0, 30, 0, 85)
            TweenService:Create(content, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 85)}):Play()
        else
            content.Visible = false
        end
    end
end

local dragging = false
local dragInput, dragStart, startPos
toggleBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = toggleBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

toggleBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

toggleBtn.MouseButton1Click:Connect(function() if not dragging then togglePanel() end end)
