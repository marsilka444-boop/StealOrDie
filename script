    if not shadowsEnabled then
        btn.Text = "ENABLE SHADOWS"
        grad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 50)), ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 150, 0))}
        
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.ClockTime = 14 
        
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("Atmosphere") or obj:IsA("Sky") or obj:IsA("BloomEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") then
                obj:Destroy()
            end
        end
        
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CastShadow = false end
        end
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("Light") then obj.Shadows = false end
        end
        
        if shadowConnection then shadowConnection:Disconnect() end
        shadowConnection = Workspace.DescendantAdded:Connect(function(desc)
            if desc:IsA("BasePart") and not shadowsEnabled then desc.CastShadow = false end
        end)
    else
        btn.Text = "DISABLE SHADOWS"
        grad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0, PurpleMain), ColorSequenceKeypoint.new(1, PurpleDark)}
        
        Lighting.GlobalShadows = true
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CastShadow = true end
        end
        if shadowConnection then shadowConnection:Disconnect() end
    end
end)

