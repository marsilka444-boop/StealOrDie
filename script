local function spamInteract(targetObj, statusLbl, actionName)
    if isCollecting then 
        statusLbl.Text = "Status: Cooldown! Wait 10s..."
        return 
    end
    if not targetObj or not targetObj.Parent then 
        playSound(SND_ERROR)
        return 
    end
    
    isCollecting = true
    task.spawn(function()
        local char, hrp = getChar()
        if not hrp then isCollecting = false; return end
        
        local originalCFrame = hrp.CFrame
        local targetPos = getObjPos(targetObj) + Vector3.new(0, 3, 0)
        
        statusLbl.Text = "Status: " .. actionName .. "..."
        
        local useBtn = nil
        for _, obj in pairs(playerGui:GetDescendants()) do
            if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
                if string.find(string.lower(obj.Name), "use") or string.find(string.lower(obj.Name), "hide") or (obj:IsA("TextButton") and string.find(string.lower(obj.Text), "использовать")) then
                    useBtn = obj
                    break
                end
            end
        end

        local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and not isInstantPromptEnabled then pcall(function() prompt.HoldDuration = 0 end) end

        for i = 1, 5 do
            hrp.CFrame = CFrame.new(targetPos)
            
            if prompt then pcall(function() fireproximityprompt(prompt) end) end
            if useBtn then
                pcall(function() useBtn:Activate() end)
                pcall(function() useBtn.MouseButton1Click:Fire() end)
            end
            
            task.wait(0.1)
        end
        
        statusLbl.Text = "Status: Returning..."
        hrp.CFrame = originalCFrame
        
        for i = 1, 3 do
            task.wait(0.1)
            unstuckCharacter()
        end
        
        playSound(SND_SUCCESS)
        task.wait(10) -- 10 СЕКУНД КД
        isCollecting = false
        statusLbl.Text = "Status: Ready"
    end)
end

