local function watchPlayer(p)
    p:GetAttributeChangedSignal("IsEntity"):Connect(function()
        if isEntityEspEnabled then updateEntityESP() end
        if isPlayerEspEnabled then updatePlayerESP() end
    end)
    if p.Character then
        p.Character:GetAttributeChangedSignal("IsEntity"):Connect(function()
            if isEntityEspEnabled then updateEntityESP() end
            if isPlayerEspEnabled then updatePlayerESP() end
        end)
    end
    p.CharacterAdded:Connect(function(char)
        task.wait(1)
        char:GetAttributeChangedSignal("IsEntity"):Connect(function()
            if isEntityEspEnabled then updateEntityESP() end
            if isPlayerEspEnabled then updatePlayerESP() end
        end)
        if isPlayerEspEnabled then updatePlayerESP() end
    end)
end

for _, p in pairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)

